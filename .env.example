# ==============================================================================
# IPO SaaS Platform — Environment Configuration Template
# Copy this file to `.env.local` and populate with your Supabase credentials.
# NOTE: Do NOT commit `.env.local` to source control.
# ==============================================================================

# Supabase Project URL (e.g., https://xyzcompany.supabase.co or http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anon Key (safe for browser exposure)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (SERVER-SIDE ONLY - NEVER expose to browser / client components)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Environment Mode
NODE_ENV=development
